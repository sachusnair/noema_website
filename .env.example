# Calendly scheduling link used by every "Book a demo" control.
# The widget script is only requested once a visitor presses one of them.
# If this is unset the buttons fall back to a mailto: link.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/noema-demo

# Form endpoint for the contact page. Submissions are posted here from the
# browser; the service holds the inbox. Leave unset and the contact page shows
# the email address instead of a form.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mgawagep
